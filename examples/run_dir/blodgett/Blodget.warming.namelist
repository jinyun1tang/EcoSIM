&regression_test
 cells   =           3
/

&ecosim
case_name='Blodget.warm'
do_regression_test=.false.
pft_file_in='../../../input_data/ecosim_pftpar_20260915.nc'
grid_file_in='../../inputs/blodgett/Blodget_grid_20240622.nc'
pft_mgmt_in='../../inputs/blodgett/Blodget_pft_20260426.ndlf.nc'
clm_hour_file_in='../../inputs/blodgett/Blodget.clim.2012-2022.nc'
clm_factor_in='NO'
soil_mgmt_in='NO'
atm_ghg_in='../../../input_data/fatm_hist_GHGs_1750-2023.nc'
! Requires hourly TEMP_vr control history files in this run directory.
! Generate them with the control case before running cable warming.
warming_exp='loc[1,1];type[Cable_heating];dT[4K];Depth[1m];hist_ctrl[Blodget.ctrl.ecosim.h1.xxxx-01-01-00000.nc];beg_time[2014/01/01];end_time[2018/12/31]'

lverbose=.false.
disp_planttrait=.true.
plant_model=.true.
microbial_model=.true.
soichem_model=.true.
!set up output variable lists
!set up the first year of simulation
start_date  = '19800101000000'
grid_mode=1    !enable lateral runoff
continue_run=.false.
!set up simulation periods, spinup starts at 1, ends at 2, with 3 cycles, regular starts at 4, ends at 5.
forc_periods=2013,2013,1,2022,2012,1,2013,2022,2,2012,2022,1

!set up solvers
NPXS=30,30,30,30,30      !number of cycles per hour for water,heat,solute flux calcns
NPYS=20,20,20,20,20      !number of cycles per NPX for gas flux calcns
NCYC_LITR=30
NCYC_SNOW=20
!set up output frequency
hist_mfilt=7665 , 7665
hist_fincl2 = 'TEMP_vr','PREC_col','SOIL_RN_col','SOIL_LE_col','SOIL_G_col','SOIL_H_col','SOL_RADN_col','EVAPGrnd_col',
  'RUNOFF_FLX_col','rWatFLP_vr','rIceFLP_vr','SNOWPACK_col','SURF_WTR_col'

hist_nhtfrq=-24, -24
/

&bbgcforc
/

!namelist for timer
&ecosim_time
rest_opt='nyears'  !'ndays','nmonths','nyears'
rest_frq=1
delta_time=3600.
stop_n=100            !this shall overwrite what is set in forc_periods
stop_option='nyears' !run by nyears, nmonths, ndays,
diag_frq=1
diag_opt='nsteps'
/



